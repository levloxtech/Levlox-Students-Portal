# Levlox Student Portal — frontend environment variables
#
# Copy to `.env` for local development, and set the same names in the Vercel
# project (Settings -> Environment Variables) for production.
#
# These Firebase Web values are client-side configuration, not secrets — they
# ship in the JavaScript bundle by design. Actual protection comes from the
# Firestore and Storage security rules in firestore.rules / storage.rules.
#
# Never add a Firebase Admin SDK service-account key here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=levlox-student-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=levlox-student-portal
VITE_FIREBASE_STORAGE_BUCKET=levlox-student-portal.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
